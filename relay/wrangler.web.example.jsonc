{
  "name": "mori-muse-relay",
  "main": "worker.template.mjs",
  "compatibility_date": "2026-10-15",
  "workers_dev": true,
  "observability": {
    "enabled": false
  },
  "assets": {
    "directory": "../studio/dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "BROWSER_ORIGINS": "[\"http://127.0.0.1:5173\",\"http://localhost:5173\"]"
  }
}
