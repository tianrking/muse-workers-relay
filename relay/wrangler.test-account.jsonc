  "assets": {
    "directory": "../studio/dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "BROWSER_ORIGINS": "[\"https://muse.2fast.cfd\",\"https://muse.tienjuiwong.workers.dev\",\"http://127.0.0.1:5173\",\"http://localhost:5173\"]"
  }
}
