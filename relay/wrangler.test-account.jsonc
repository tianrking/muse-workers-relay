{
  "name": "muse",
  "account_id": "4a5f505ca64b8acb9341dcff4b167265",
  "main": "worker.template.mjs",
  "compatibility_date": "2026-10-15",
  "workers_dev": true,
  "observability": {
    "enabled": false
  },
  "routes": [
    {
      "pattern": "muse.2fast.cfd",
      "custom_domain": true
    }
