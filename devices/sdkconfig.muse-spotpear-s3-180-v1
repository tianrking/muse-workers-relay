# Spotpear ESP32-S3 1.8-inch 360x360 round V1; measured COM3: 16MB Flash, 8MB Octal PSRAM.
# GPIO and init source: ../Demo_Arduino/ST77916_LVGL_DEMO and manufacturer's five schematics.
# Load after sdkconfig.defaults and devices/sdkconfig.muse. System ESP-IDF 6.1.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_MUSE_BOARD_SPOTPEAR_S3_180_V1=y
CONFIG_HOMEHUB_BUTTON_GPIO=0
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=n
CONFIG_SPIRAM_MEMTEST=y
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
CONFIG_ESP_PHY_INIT_DATA_IN_PARTITION=n
CONFIG_MUSE_CJK_FONT=y
CONFIG_MUSE_DEFAULT_VOLUME=25
CONFIG_HOMEHUB_NVS_ENCRYPTION=n
CONFIG_SECURE_BOOT=n
CONFIG_FLASH_ENCRYPTION_ENABLED=n

# Cloudflare can serve GTS roots cross-signed by a legacy issuer.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_CROSS_SIGNED_VERIFY=y
